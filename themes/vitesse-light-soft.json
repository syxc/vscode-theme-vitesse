  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#a0ada0"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.class",
        "storage.function"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.boolean",
        "constant.language",
        "constant.character",
        "constant.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template",
        "string.interpolated",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#0a3069"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#59873a"
      }
    },
    {
      "scope": [
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#59873a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.struct",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#5a6aa6"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#5a6aa6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "variable.other.object",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "tag.html"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#24292f"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#ab5959"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "variable.other.readwrite.alias"
