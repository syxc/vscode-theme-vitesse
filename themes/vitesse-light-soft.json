      "settings": {
        "foreground": "#bd8f8f"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.typeParameter"
      ],
      "settings": {
        "foreground": "#5a6aa6"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#998418"
      }
    },
    {
      "scope": [
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1a7f37"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9a6700"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    }
