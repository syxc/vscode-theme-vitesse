  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#b05a78",
    "property": "#998418",
    "interface": "#2e808f",
    "type": "#2e808f",
    "class": "#5a6aa6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#a0ada0"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#1e754f"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.class",
        "storage.function"
      ],
      "settings": {
        "foreground": "#ab5959"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.boolean",
        "constant.language",
        "constant.character",
        "constant.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#a65e2b"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template",
        "string.interpolated",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b56959"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#59873a"
      }
    },
    {
      "scope": [
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#59873a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.struct",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#2e8f82"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#2e8f82"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "variable.other.object",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "tag.html"
      ],
      "settings": {
        "foreground": "#1e754f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#ab5959"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#b05a78"
      }
    },
    {
      "scope": [
        "entity.name.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#b05a78"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.typeParameter"
      ],
      "settings": {
        "foreground": "#b05a78"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b07d48"
      }
    },
    {
      "scope": [
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#2e8f82"
      }
    },
    {
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1e754f"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ab5959"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#bda437"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#ab5959"
      }
    }
