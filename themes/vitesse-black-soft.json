      "settings": {
        "foreground": "#d49585"
      }
    },
    {
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#d4958577"
      }
    },
    {
      "scope": [
        "punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#c4b57077"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#c4b570"
      }
    },
    {
      "scope": [
        "property",
        "meta.property-name",
        "meta.object-literal.key",
