  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#db889a",
    "property": "#b8a965",
    "interface": "#5d99a9",
    "type": "#5d99a9",
    "class": "#6872ab"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#758575dd"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#4d9375"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.class",
        "storage.function"
      ],
      "settings": {
        "foreground": "#cb7676"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.boolean",
        "constant.language",
        "constant.character",
        "constant.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#c99076"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template",
        "string.interpolated",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c98a7d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#80a665"
      }
    },
    {
      "scope": [
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#80a665"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.struct",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#5DA994"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#5DA994"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "variable.other.object",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#bd976a"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#bd976a"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "tag.html"
      ],
      "settings": {
        "foreground": "#4d9375"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#bd976a"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#cb7676"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#db889a"
      }
    },
    {
      "scope": [
        "entity.name.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#db889a"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.typeParameter"
      ],
      "settings": {
        "foreground": "#db889a"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#bd976a"
      }
    },
    {
      "scope": [
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#5DA994"
      }
    },
    {
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4d9375"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#cb7676"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e6cc77"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#cb7676"
      }
    }
  ],
